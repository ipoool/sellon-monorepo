# === API ===
API_PORT=8080
API_ENV=development
API_LOG_LEVEL=debug
# Auto-cancel a 'pending'/'unpaid' order (with no payment proof uploaded) after
# this many hours, releasing its stock + digital kuota + promo. 0 = disabled.
ORDER_EXPIRY_HOURS=1

# CORS allowlist for the web origin (comma-separated for multiple).
WEB_ORIGIN=http://localhost:3000,http://localhost:3100

# Public base URL for webhooks. Sellers paste {WEBHOOK_BASE_URL}/webhooks/midtrans/{token}
# into Midtrans dashboard. In dev, expose via ngrok/cloudflared and put that URL here.
WEBHOOK_BASE_URL=http://localhost:8080

# === Auth ===
# Generate dev secret: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_TTL_HOURS=168

# Google OAuth Client ID — get one at https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID -> "Web application"
# Authorized JavaScript origins: http://localhost:3000 (and http://localhost:3100 if used)
# The same value is shared by the API (for ID token verification) and the web (for the GIS button).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === Database (PostgreSQL) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sellon
POSTGRES_PASSWORD=sellon
POSTGRES_DB=sellon

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Web ===
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Internal URL the Next.js server uses to reach the API (server-side fetch).
API_INTERNAL_URL=http://api:8080

# === Auth: sign-in options ===
# Google Sign-In. Both must hold the SAME client id (one verifies the ID
# token server side, the other is only a fallback for the browser — the id
# is normally served to the login page at runtime via /api/v1/info, so it
# can be rotated without rebuilding the web bundle).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email+password signup, resend-code and password reset. Set to false when
# outbound mail is unavailable: all three end on a code that never arrives,
# so the login page hides them and points people at Google instead. Signing
# in with an existing password is NOT affected — it needs no delivery.
# Flipping this only needs an api restart, not a web rebuild.
AUTH_EMAIL_SIGNUP_ENABLED=true

# === Object storage: S3-compatible (uploads) ===
# ACTIVE backend for every upload: product photos, store logo/banner, QRIS,
# payment proofs, and digital product files. Uploads go through the Go API,
# so the secret key never reaches the browser.
#
# Defaults below already point at the Cloudeka bucket; you only need to fill
# in the two credentials. Leave them as YOUR_ACCESS_KEY / YOUR_SECRET_KEY and
# the API treats storage as unconfigured: /uploads/* answers 503 and the UI
# falls back to URL-only input (instead of failing with an opaque 403).
#
# The bucket stays PRIVATE. Cloudeka ignores per-object ACLs, and we don't want
# a world-readable bucket, so reads go through the API instead: every stored
# asset URL points at `{API}/api/v1/files/{key}`, which streams the object with
# a signed request. Nothing but the API needs storage credentials.
#
# S3_PUBLIC_BASE_URL is that prefix. It defaults to WEBHOOK_BASE_URL + /api/v1/files
# (the API's publicly reachable origin), so you normally leave it unset. Set it
# only to put a CDN in front — stored rows keep working because the prefix is
# resolved at read time, not baked into the database.
#
# Object layout (auto-created on first upload):
#   {store_id}/products/...          ← katalog produk
#   {store_id}/commons/logos/...     ← logo toko
#   {store_id}/commons/banners/...   ← banner storefront
#   {store_id}/commons/qris/...      ← QRIS statis
#   {store_id}/digital/...           ← file produk digital
#   {store_id}/payment_proofs/...    ← bukti transfer pembeli
#   platform/banners/...             ← banner platform (admin)
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are accepted as aliases.
S3_ENDPOINT=https://kencana.basic.box.cloudeka.id
S3_REGION=kencana
S3_BUCKET=sellon-bucket-cosdi7
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
# S3_PUBLIC_BASE_URL=https://cdn.sellon.id/files

# === Supabase Storage (LEGACY — deletes only) ===
# Superseded by S3 above. Keep these set ONLY while rows still reference a
# Supabase public URL, so deleting a product/store can still clean up the old
# object. Nothing new is ever written here. Once no Supabase URL remains in
# the database, unset all three and the client drops out entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=stores

# === RajaOngkir (live ongkir) ===
# Sign up at https://rajaongkir.com to get an API key. Without these the
# /shipping/quote endpoint falls back to the built-in zone-based table.
# Tier matches your account: starter (free, JNE/TIKI/POS) | basic | pro.
RAJAONGKIR_API_KEY=EOoWckjO08bd9a6324316c55ZvmcdWez
RAJAONGKIR_TIER=starter

# === Platform billing (SaaS subscription via Midtrans Snap) ===
# Separate Midtrans account owned by SellOn (not the seller's). When a
# seller upgrades to Pro/Bisnis they're sent to a Snap page billed
# against this account. Leave the server key empty to disable online
# checkout — the UI then only shows the "transfer manual" path.
# Webhook URL to register in this account's dashboard:
#   {WEBHOOK_BASE_URL}/webhooks/platform/midtrans
PLATFORM_MIDTRANS_SERVER_KEY=
PLATFORM_MIDTRANS_CLIENT_KEY=

# === Email (Mailtrap Send API) ===
# Sends transactional notifications to sellers (pesanan baru, pembayaran
# diterima). Uses Mailtrap's HTTPS Send API — not SMTP. Get a token from
# Mailtrap → Sending → API Tokens. Without MAILTRAP_API_KEY, email
# becomes a no-op (logs only). FROM_EMAIL must be on a verified sender
# domain in your Mailtrap account.
MAILTRAP_API_KEY=1db51ac6795d19d18f51cc66e6078b26
FROM_EMAIL=noreply@sellon.id
FROM_NAME=SellOn

# Twilio — platform-funded WhatsApp alerts to sellers when a new order
# arrives. Account SID + Auth Token from console.twilio.com. WhatsApp
# From is the sender phone in E.164 (no "whatsapp:" prefix — the code
# adds it). Sandbox sender is +14155238886 during onboarding; switch
# to your approved production number before launch. Leaving any of
# the three empty disables outbound WA — order create still succeeds,
# we just log a warning.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# === AI Content Generation (Anthropic Claude) ===
# Used by the weekly marketing tips scheduler to generate fresh email content
# every Monday. Without this key the scheduler falls back to the built-in
# static tip pool (8 rotating tips). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Custom Domain ──────────────────────────────────────────────────────────────
# CNAME target that sellers must point their custom domain at.
# In production, configure your reverse proxy (Caddy/nginx) to also accept
# requests on this hostname and forward to the web container.
# Shown on the Settings → Domain page so sellers know what to enter.
CNAME_TARGET=cname.sellon.id
NEXT_PUBLIC_CNAME_TARGET=cname.sellon.id
